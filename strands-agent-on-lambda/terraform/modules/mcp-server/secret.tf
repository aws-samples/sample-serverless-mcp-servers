# Shared secret used to sign (Agent) and verify (MCP Authorizer, MCP Server)
# JWTs passed from the Agent to the MCP Server.
#
# The value is generated by an ephemeral resource and written to Secrets Manager
# through a write-only argument, so it never lands in Terraform plan or state.
# Lambda functions receive the secret ARN only and fetch the value on startup.

# 64 alphanumeric chars ~= 381 bits of entropy, above the 256-bit minimum
# RFC 7518 requires for HS256 keys.
ephemeral "random_password" "jwt_signature_secret" {
  length  = 64
  special = false
}

resource "aws_secretsmanager_secret" "jwt_signature_secret" {
  name_prefix = "bookings-mcp-jwt-signature-secret-"
  description = "Shared secret for signing/verifying Agent-to-MCP JWTs"

  # Delete immediately on destroy, so destroy/apply cycles don't collide
  # with a secret pending deletion. Use a recovery window in production.
  recovery_window_in_days = 0
}

resource "aws_secretsmanager_secret_version" "jwt_signature_secret" {
  secret_id        = aws_secretsmanager_secret.jwt_signature_secret.id
  secret_string_wo = ephemeral.random_password.jwt_signature_secret.result
  # The value is only written when this version changes. Bump it to rotate
  # the secret, then restart the functions (e.g. redeploy) to pick it up.
  secret_string_wo_version = 1
}
